DATABASE_URL=postgresql://postgres:postgres@localhost:5432/approvaliq
JWT_SECRET=change-me
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
LLM_PROVIDER=mock
# Anthropic adapter (only needed when LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
EXTRACTION_REVIEW_THRESHOLD=0.6
PORT=3001
# Web frontend: base URL of the NestJS API (consumed as import.meta.env.VITE_API_URL).
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
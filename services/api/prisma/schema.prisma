generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model for the scaffold phase. The real regulatory schema
// (BusinessProfile, Approval, Document, Authority, ...) lands in Phase 1.
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

enum Role {
  applicant
  officer
  admin
}

// Minimal user record backing the auth skeleton. Extended in later phases.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(applicant)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

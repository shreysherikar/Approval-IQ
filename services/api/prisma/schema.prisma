generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE (Phase 1, enforced): historical releases are immutable at the
// persistence boundary (PostgreSQL triggers — see migration
// `20260914000000_release_immutability`), not only in the importer. Once a
// KnowledgeRelease.status = 'published', the database rejects UPDATE/DELETE of
// that release row and of any ApprovalDefinition / Dependency /
// ApprovalDocumentRequirement row tied (directly or transitively) to it.
// Draft releases remain editable so the import pipeline can load/iterate.
// The formal draft/review/publish state machine and per-claim evidence
// granularity (claim/evidence-per-fact) arrive in Phase 13 per blueprint §15;
// Phase 1 stores provenance per Source + per ApprovalDefinition (url, notes,
// verificationStatus, lastVerifiedDate, sourceLastReviewed, stalenessFlag).

model Industry {
  id        String               @id @default(uuid())
  code      String               @unique
  name      String
  approvals ApprovalDefinition[]

  @@map("industries")
}

model Authority {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  department    String?
  jurisdiction  String?
  officialUrl   String?              @map("official_url")
  approvals     ApprovalDefinition[]
  issuedDocs    DocumentDefinition[] @relation("IssuingAuthority")
  // Phase 9: officer queue scoping + denormalized clarification scope.
  officerAssignments OfficerAuthorityAssignment[]
  clarifications     ClarificationRequest[]

  @@map("authorities")
}

enum VerificationStatus {
  research_verified
  production_verified
}

model Source {
  id                 String               @id @default(uuid())
  url                String
  title              String
  department         String?
  publishedDate      DateTime?            @map("published_date")
  retrievedDate      DateTime             @map("retrieved_date")
  lastVerifiedDate   DateTime             @map("last_verified_date")
  verifiedBy         String               @map("verified_by")
  notes              String?              @db.Text
  sourceLastReviewed DateTime?            @map("source_last_reviewed") @db.Date
  verificationStatus VerificationStatus   @default(research_verified) @map("verification_status")
  stalenessFlag      Boolean              @default(false) @map("staleness_flag")
  approvals          ApprovalDefinition[]

  @@map("sources")
}

enum KnowledgeReleaseStatus {
  draft
  published
}

model KnowledgeRelease {
  id             String                 @id @default(uuid())
  version        String                 @unique
  status         KnowledgeReleaseStatus @default(draft)
  publishedAt    DateTime?              @map("published_at")
  publishedBy    String?                @map("published_by")
  changeSummary  String?                @map("change_summary") @db.Text
  approvals      ApprovalDefinition[]
  evaluationRuns EvaluationRun[]

  @@map("knowledge_releases")
}

model ApprovalDefinition {
  id                      String                        @id @default(uuid())
  code                    String                        @unique
  name                    String
  shortName               String?                       @map("short_name")
  ruleKind                String                        @default("approval") @map("rule_kind")
  jurisdiction            String?
  industryId              String                        @map("industry_id")
  industry                Industry                      @relation(fields: [industryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorityId             String                        @map("authority_id")
  authority               Authority                     @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  whyRequired             String                        @map("why_required") @db.Text
  applicabilityConditions Json?                         @map("applicability_conditions") @db.JsonB
  exclusionConditions     Json?                         @map("exclusion_conditions") @db.JsonB
  exclusionReason         String?                       @map("exclusion_reason") @db.Text
  inspectionRequired      Boolean                       @map("inspection_required")
  renewalRequired         Boolean                       @map("renewal_required")
  slaDays                 Int?                          @map("sla_days")
  officialApplicationUrl  String?                       @map("official_application_url")
  ambiguityNotes          String?                       @db.Text
  // Verification state is INHERITED via sourceId -> Source
  // (verificationStatus/stalenessFlag/lastVerifiedDate). Do NOT duplicate those
  // columns here; per-row copies drift out of sync.
  sourceId                String                        @map("source_id")
  source                  Source                        @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastVerifiedDate        DateTime                      @map("last_verified_date")
  releaseId               String?                       @map("release_id")
  release                 KnowledgeRelease?             @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirements            ApprovalDocumentRequirement[]
  outgoingDeps            Dependency[]                  @relation("DepFrom")
  incomingDeps            Dependency[]                  @relation("DepTo")
  evaluationResults       EvaluationResult[]
  instances               ApprovalInstance[]

  @@map("approval_definitions")
}

enum DocumentReusability {
  reusable
  conditional
  fresh_required
  unknown
}

model DocumentDefinition {
  id                 String                        @id @default(uuid())
  code               String                        @unique
  name               String
  documentType       String                        @map("document_type")
  issuingAuthorityId String?                       @map("issuing_authority_id")
  issuingAuthority   Authority?                    @relation("IssuingAuthority", fields: [issuingAuthorityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  validityRule       String                        @map("validity_rule")
  reusability        DocumentReusability
  reuseConditions    String                        @map("reuse_conditions") @db.Text
  verificationMethod String                        @map("verification_method") @db.Text
  requirements       ApprovalDocumentRequirement[]
  documents          Document[]

  @@map("document_definitions")
}

model ApprovalDocumentRequirement {
  id                   String             @id @default(uuid())
  approvalDefinitionId String             @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition @relation(fields: [approvalDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentDefinitionId String             @map("document_definition_id")
  documentDefinition   DocumentDefinition @relation(fields: [documentDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  condition            String?            @db.Text

  @@map("approval_document_requirements")
}

enum DependencyRelationship {
  depends_on
  informational
  parallel_with
  unknown
}

model Dependency {
  id              String                 @id @default(uuid())
  fromApprovalId  String                 @map("from_approval_id")
  fromApproval    ApprovalDefinition     @relation("DepFrom", fields: [fromApprovalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relationship    DependencyRelationship
  toApprovalId    String                 @map("to_approval_id")
  toApproval      ApprovalDefinition     @relation("DepTo", fields: [toApprovalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  condition       String?                @db.Text
  // REQUIRED when relationship = depends_on: specific evidence for a genuine
  // workflow-gating relationship. Enforced by CHECK constraint
  // dependencies_depends_on_requires_rationale in the migration + service-layer
  // validation (reject depends_on with empty gatingRationale).
  gatingRationale String?                @map("gating_rationale") @db.Text

  @@map("dependencies")
}

enum Role {
  applicant
  officer
  admin
}

// Minimal user record backing the auth skeleton. Extended in later phases.
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String?           @map("password_hash")
  googleId         String?           @unique @map("google_id")
  authProvider     String            @default("local") @map("auth_provider")
  role             Role              @default(applicant)
  memberships      ProjectMember[]
  uploadedVersions DocumentVersion[]
  corrections      FieldCorrection[]
  verificationRuns VerificationRecord[]
  // Phase 9: which authorities an officer may act for, and the attribution of
  // every clarification action (append-only — never overwritten).
  officerAssignments     OfficerAuthorityAssignment[] @relation("OfficerAuthorityAssignments")
  clarificationsRequested ClarificationRequest[]      @relation("ClarificationRequester")
  clarificationsResolved  ClarificationRequest[]      @relation("ClarificationResolver")
  clarificationResponses  ClarificationResponse[]     @relation("ClarificationResponseAuthor")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model EvaluationRun {
  id              String             @id @default(uuid())
  profileSnapshot Json               @map("profile_snapshot") @db.JsonB
  releaseId       String?            @map("release_id")
  release         KnowledgeRelease?  @relation(fields: [releaseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  engineVersion   String             @map("engine_version")
  resultSnapshot  Json               @map("result_snapshot") @db.JsonB
  createdAt       DateTime           @default(now()) @map("created_at")
  results         EvaluationResult[]

  @@map("evaluation_runs")
}

model EvaluationResult {
  id                   String             @id @default(uuid())
  evaluationRunId      String             @map("evaluation_run_id")
  evaluationRun        EvaluationRun      @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvalDefinitionId String             @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition @relation(fields: [approvalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outcome              String
  missingFields        Json               @map("missing_fields") @db.JsonB
  instance             ApprovalInstance?

  @@map("evaluation_results")
}

// ---------------------------------------------------------------------------
// Phase 4: Approval roadmap. An ApprovalInstance is the applicant-facing
// "thing to act on" derived from one specific EvaluationResult. The instance
// NEVER stores its own outcome or attention flag: it always traces back to the
// pinned evaluation result (attentionRequired is derived at read time from
// evaluationResult.outcome === 'not_evaluable'), so it cannot drift out of
// sync with the actual evaluation. `status` is the manual progress state
// machine (blocked | available | in_progress | done) driven by the
// dependency graph, not by evaluation outcomes.
// ---------------------------------------------------------------------------

enum ApprovalInstanceStatus {
  blocked
  available
  in_progress
  done
}

model ApprovalInstance {
  id                   String                 @id @default(uuid())
  projectId            String                 @map("project_id")
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvalDefinitionId String                 @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition     @relation(fields: [approvalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // The specific EvaluationResult that produced this instance. Outcome is never
  // recomputed or restated here — always read it through this relation.
  evaluationResultId   String                 @unique @map("evaluation_result_id")
  evaluationResult     EvaluationResult       @relation(fields: [evaluationResultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status               ApprovalInstanceStatus @default(blocked)
  // Set (once) when the server's dependency re-evaluation first makes this
  // instance available. Never set by the client.
  unlockedAt           DateTime?              @map("unlocked_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  documents            ApprovalInstanceDocument[]
  jointInspections     JointInspectionApproval[]
  // Phase 9: clarifications raised by an authority officer on THIS application.
  clarifications       ClarificationRequest[]

  // One roadmap slot per approval per project; re-evaluations re-point the
  // same instance at the newer evaluation result.
  @@unique([projectId, approvalDefinitionId])
  @@index([projectId])
  @@map("approval_instances")
}

// ---------------------------------------------------------------------------
// Phase 6: ApprovalInstanceDocument join table.
// Allows a single Document to be referenced by multiple ApprovalInstances
// without duplicating the underlying file — "application packet references".
// ---------------------------------------------------------------------------

model ApprovalInstanceDocument {
  id                  String           @id @default(uuid())
  approvalInstanceId  String           @map("approval_instance_id")
  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentId          String           @map("document_id")
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt           DateTime         @default(now()) @map("created_at")

  @@unique([approvalInstanceId, documentId])
  @@map("approval_instance_documents")
}

// ---------------------------------------------------------------------------
// Phase 3: Projects + BusinessProfileVersioning. Intentionally minimal — full
// business/premises/membership modeling (Section 4 of the blueprint) is
// Phase 4+ work. Only what's needed to anchor profile versions is modeled now.
// ---------------------------------------------------------------------------

model Project {
  id                String                   @id @default(uuid())
  name              String
  industry          String
  businessId        String                   @map("business_id")
  profiles          BusinessProfileVersion[]
  approvalInstances ApprovalInstance[]
  members           ProjectMember[]
  documents         Document[]
  consistencyCheckResults ConsistencyCheckResult[]
  jointInspections  JointInspection[]
  // Phase 9: applicant-visible clarification inbox for this project.
  clarifications     ClarificationRequest[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@map("projects")
}

enum ProfileStatus {
  draft
  confirmed
}

// Append-only profile versioning: a draft can be mutated freely; once
// confirmed it is immutable — further edits create a NEW version. Immutability
// is enforced in the ProfilesService (explicit status check), not via DB
// triggers (same approach as the Phase-1 KnowledgeRelease note above).
model BusinessProfileVersion {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionNumber Int           @map("version_number")
  values        Json          @db.JsonB
  status        ProfileStatus @default(draft)
  confirmedAt   DateTime?     @map("confirmed_at")
  // Phase 7: profile-vs-document consistency checks pinned to the exact
  // profile version whose values were compared.
  consistencyChecks ConsistencyCheckResult[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("business_profile_versions")
}

// ---------------------------------------------------------------------------
// Phase 5: Document Vault.
//
// A Document is a logical object (per project) with an append-only chain of
// DocumentVersions. There is deliberately NO storage delete: superseding a
// document only marks the prior version "superseded"; its bytes stay in object
// storage. `currentVersionId` points at the latest version.
// ---------------------------------------------------------------------------

/**
 * The full lifecycle for a document version. Most states are only reachable
 * after Phase 6 (async extraction); the enum is defined in full now so there is
 * no later migration, but only `uploaded` and `superseded` are set this phase.
 */
enum DocumentVersionState {
  uploaded
  queued
  processing
  extracted
  needs_verification
  verified
  rejected
  superseded
  archived
}

/**
 * A user's membership in a project — the object-level authorization boundary.
 * A user may only read/write a project's documents when a ProjectMember row
 * links them to that project (never "just a valid JWT").
 */
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Document {
  id                   String              @id @default(uuid())
  projectId            String              @map("project_id")
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Classification may be unset or manual today; auto-classification is Phase 6.
  documentDefinitionId String?             @map("document_definition_id")
  documentDefinition   DocumentDefinition? @relation(fields: [documentDefinitionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Tracks if documentDefinitionId was manually overridden (Phase 6: manual override always wins)
  documentDefinitionManualOverride Boolean   @default(false) @map("document_definition_manual_override")
  // Free-text metadata for manual corrections/annotations
  metadata             Json?               @db.JsonB
  currentVersionId     String?             @unique @map("current_version_id")
  currentVersion       DocumentVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions             DocumentVersion[]   @relation("Owned")
  approvalInstances    ApprovalInstanceDocument[]
  consistencyCheckResults ConsistencyCheckResult[]
  // Phase 9: documents offered as evidence when answering a clarification.
  clarificationResponses ClarificationResponseDocument[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("documents")
}

enum JobStatus {
  pending
  processing
  completed
  failed
  dead_letter
}

model Job {
  id                   String    @id @default(uuid())
  type                 String
  payload              Json      @db.JsonB
  payloadSchemaVersion Int       @default(1) @map("payload_schema_version")
  attemptCount         Int       @default(0) @map("attempt_count")
  idempotencyKey       String    @unique @map("idempotency_key")
  status               JobStatus @default(pending)
  errorDetails         String?   @map("error_details") @db.Text
  retryPolicy          Json      @map("retry_policy") @db.JsonB
  nextAttemptAt        DateTime  @default(now()) @map("next_attempt_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([type, status])
  @@map("jobs")
}

model DocumentVersion {
  id               String               @id @default(uuid())
  documentId       String               @map("document_id")
  document         Document             @relation("Owned", fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Inverse of Document.currentVersion — lets one side of the self-reference
  // resolve without ambiguity.
  currentFor       Document?            @relation("CurrentVersion")
  versionNumber    Int                  @map("version_number")
  // Opaque key into StorageProvider. Never exposed as a fetchable URL.
  storageKey       String               @map("storage_key")
  originalFilename String               @map("original_filename")
  mimeType         String               @map("mime_type")
  sizeBytes        Int                  @map("size_bytes")
  // sha256 (Phase 7 content dedup).
  fileHash         String               @map("file_hash")
  uploadedByUserId String               @map("uploaded_by_user_id")
  uploadedBy       User                 @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedAt       DateTime             @default(now()) @map("uploaded_at")
  state            DocumentVersionState @default(uploaded)
  extractions      ExtractionResult[]
  corrections      FieldCorrection[]
  verifications    VerificationRecord[]
  // Phase 7 consistency checks where this version is the SUBJECT (checked
  // against the profile or another document). Consistency is a WARNING layer:
  // these rows never gate this version's state or its attachability.
  consistencyChecksAsSubject ConsistencyCheckResult[] @relation("ConsistencySubjectVersion")
  consistencyChecksAsOther   ConsistencyCheckResult[] @relation("ConsistencyOtherVersion")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// Every ExtractionResult row is self-describing about what produced it.
model ExtractionResult {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fields            Json            @db.JsonB
  modelProvider     String          @map("model_provider")
  modelVersion      String          @map("model_version")
  promptVersion     String          @map("prompt_version")
  extractedAt       DateTime        @default(now()) @map("extracted_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@map("extraction_results")
}

// User corrections stored ALONGSIDE (never over) the raw extraction output.
model FieldCorrection {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fieldName         String          @map("field_name")
  correctedValue    String          @map("corrected_value") @db.Text
  source            String          @default("user_corrected")
  correctedByUserId String          @map("corrected_by_user_id")
  correctedBy       User            @relation(fields: [correctedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@map("field_corrections")
}

model VerificationRecord {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verifierUserId    String          @map("verifier_user_id")
  verifier          User            @relation(fields: [verifierUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedAt        DateTime        @default(now()) @map("verified_at")
  fieldsVerified    Json            @map("fields_verified") @db.JsonB
  notes             String?         @db.Text
  method            String          @default("manual_review")
  evidenceInspected Boolean         @map("evidence_inspected")
  verifiedBy        String          @default("applicant") @map("verified_by")

  @@index([documentVersionId])
  @@map("verification_records")
}

// ---------------------------------------------------------------------------
// Phase 7: Consistency checks (blueprint Section 8). A WARNING layer only:
// this module has NO permission to change a DocumentVersion's state or block
// confirmation of anything. Every row records the exact sides compared and
// one of the six blueprint outcomes (match | mismatch | missing | unknown |
// not_applicable | not_verified) — outcomes are never collapsed.
// ---------------------------------------------------------------------------
enum ConsistencyCheckType {
  profile_vs_document
  document_vs_document
}

model ConsistencyCheckResult {
  id                    String               @id @default(uuid())
  projectId             String               @map("project_id")
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentId            String               @map("document_id")
  document              Document             @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // The subject version that was checked.
  documentVersionId     String               @map("document_version_id")
  documentVersion       DocumentVersion      @relation("ConsistencySubjectVersion", fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // The profile version whose confirmed values were compared (profile_vs_document).
  profileVersionId      String?              @map("profile_version_id")
  profileVersion        BusinessProfileVersion? @relation(fields: [profileVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The other document version (document_vs_document).
  otherDocumentVersionId String?             @map("other_document_version_id")
  otherDocumentVersion  DocumentVersion?     @relation("ConsistencyOtherVersion", fields: [otherDocumentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  checkType             ConsistencyCheckType @map("check_type")
  checkId               String               @map("check_id")
  profileField          String?              @map("profile_field")
  documentField         String               @map("document_field")
  // Resolved side values at check time (for reviewer display).
  sideAValue            String?              @map("side_a_value")
  sideBValue            String?              @map("side_b_value")
  // One of: match | mismatch | missing | unknown | not_applicable | not_verified
  outcome               String
  tolerancePct          Float?               @map("tolerance_pct")
  detail                String?
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@index([projectId])
  @@map("consistency_check_results")
}

// ---------------------------------------------------------------------------
// Feature #7: Joint Inspection Planning System
// ---------------------------------------------------------------------------

enum JointInspectionStage {
  pre_construction
  plant_readiness
  pre_commissioning
  annual_compliance
}

enum JointInspectionStatus {
  draft
  scheduled
  in_progress
  completed
  rescheduled
  cancelled
}

enum InspectorSignoffStatus {
  pending
  satisfactory
  needs_rectification
  rejected
}

model JointInspection {
  id                 String                    @id @default(uuid())
  projectId          String                    @map("project_id")
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title              String
  stage              JointInspectionStage
  status             JointInspectionStatus     @default(draft)
  scheduledDate      DateTime?                 @map("scheduled_date")
  timeSlot           String?                   @map("time_slot")
  premisesAddress    String?                   @map("premises_address")
  leadAuthorityCode  String?                   @map("lead_authority_code")
  leadAuthorityName  String?                   @map("lead_authority_name")
  notes              String?                   @db.Text
  readinessChecklist Json?                     @map("readiness_checklist") @db.JsonB
  slotNegotiation    Json?                     @map("slot_negotiation") @db.JsonB
  rectificationPlan  Json?                     @map("rectification_plan") @db.JsonB
  jointReportSummary String?                   @map("joint_report_summary") @db.Text
  participatingApprovals JointInspectionApproval[]
  inspectorChecklists    JointInspectorChecklist[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("joint_inspections")
}

model JointInspectionApproval {
  id                   String           @id @default(uuid())
  jointInspectionId    String           @map("joint_inspection_id")
  jointInspection      JointInspection  @relation(fields: [jointInspectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvalInstanceId   String?          @map("approval_instance_id")
  approvalInstance     ApprovalInstance? @relation(fields: [approvalInstanceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvalCode         String           @map("approval_code")
  approvalName         String           @map("approval_name")
  authorityCode        String           @map("authority_code")
  authorityName        String           @map("authority_name")
  specificRequirements String?          @map("specific_requirements") @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")

  @@unique([jointInspectionId, approvalCode])
  @@map("joint_inspection_approvals")
}

model JointInspectorChecklist {
  id                   String                 @id @default(uuid())
  jointInspectionId    String                 @map("joint_inspection_id")
  jointInspection      JointInspection        @relation(fields: [jointInspectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorityCode        String                 @map("authority_code")
  authorityName        String                 @map("authority_name")
  inspectorName        String?                @map("inspector_name")
  inspectorDesignation String?                @map("inspector_designation")
  status               InspectorSignoffStatus @default(pending)
  items                Json                   @db.JsonB
  findingsNotes        String?                @map("findings_notes") @db.Text
  signedOffAt          DateTime?              @map("signed_off_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([jointInspectionId, authorityCode])
  @@map("joint_inspector_checklists")
}


// Phase 9: officer side of the workflow. Two additions, both deliberately
// narrow:
//
// 1. OfficerAuthorityAssignment — object-level authorization for officers.
//    An `officer` may ONLY act on approvals whose ApprovalDefinition belongs to
//    an Authority they are assigned to; `admin` is unrestricted (see
//    OfficerGuard). A valid JWT proving role=officer is NOT sufficient —
//    exactly the same principle as ProjectMemberGuard for applicants.
//
// 2. ClarificationRequest / ClarificationResponse / ClarificationResponseDocument
//    — the persisted two-sided loop: officer asks → applicant answers (with
//    optional evidence documents) → officer resolves. Append-only per the
//    repo's provenance approach: responses are never edited or deleted, and
//    every status change is attributed to the user who caused it.
//    Status is a strict state machine (src/clarifications/clarification-state.ts):
//      requested --applicant_response--> responded
//      requested --officer_follow_up--> requested   (waiting on applicant)
//      responded --officer_follow_up--> requested
//      responded --officer_resolve----> resolved
//      requested --officer_resolve----> resolved
//      requested|responded --officer_cancel--> cancelled
//    resolved / cancelled are terminal.
// ---------------------------------------------------------------------------

model OfficerAuthorityAssignment {
  id          String    @id @default(uuid())
  officerId   String    @map("officer_id")
  officer     User      @relation("OfficerAuthorityAssignments", fields: [officerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorityId String    @map("authority_id")
  authority   Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([officerId, authorityId])
  @@index([authorityId])
  @@map("officer_authority_assignments")
}

enum ClarificationStatus {
  requested
  responded
  resolved
  cancelled
}

model ClarificationRequest {
  id                 String               @id @default(uuid())
  approvalInstanceId String               @map("approval_instance_id")
  approvalInstance   ApprovalInstance     @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Denormalized so the applicant inbox is a single indexed read and the
  // officer scope check never needs a three-table join.
  projectId          String               @map("project_id")
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorityId        String               @map("authority_id")
  authority          Authority            @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUserId  String               @map("requested_by_user_id")
  requestedBy        User                 @relation("ClarificationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subject            String
  message            String               @db.Text
  // The exact profile fields / document codes the officer is asking about, as a
  // JSON snapshot taken at request time. Never re-derived at read time, so the
  // ask cannot drift from what was actually asked.
  requestedFields    Json                 @default("[]") @map("requested_fields") @db.JsonB
  status             ClarificationStatus  @default(requested)
  dueAt              DateTime?            @map("due_at")
  respondedAt        DateTime?            @map("responded_at")
  resolvedAt         DateTime?            @map("resolved_at")
  resolvedByUserId   String?              @map("resolved_by_user_id")
  resolvedBy         User?                @relation("ClarificationResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolutionNote     String?              @map("resolution_note") @db.Text
  responses          ClarificationResponse[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([approvalInstanceId])
  @@index([authorityId, status])
  @@map("clarification_requests")
}

model ClarificationResponse {
  id                     String               @id @default(uuid())
  clarificationRequestId String               @map("clarification_request_id")
  clarificationRequest   ClarificationRequest @relation(fields: [clarificationRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorUserId           String               @map("author_user_id")
  author                 User                 @relation("ClarificationResponseAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Role AT THE TIME of writing — recorded so a later role change cannot
  // rewrite who said what.
  authorRole             Role                 @map("author_role")
  message                String               @db.Text
  documents              ClarificationResponseDocument[]
  createdAt              DateTime             @default(now()) @map("created_at")

  @@index([clarificationRequestId])
  @@map("clarification_responses")
}

model ClarificationResponseDocument {
  id                      String                @id @default(uuid())
  clarificationResponseId String                @map("clarification_response_id")
  clarificationResponse   ClarificationResponse @relation(fields: [clarificationResponseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentId              String                @map("document_id")
  document                Document              @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt               DateTime              @default(now()) @map("created_at")

  @@unique([clarificationResponseId, documentId])
  @@map("clarification_response_documents")
}


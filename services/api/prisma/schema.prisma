generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE (Phase 1): partial immutability is enforced in the service layer, not via
// DB triggers. Once a KnowledgeRelease.status = 'published', the API layer must
// reject edits to any ApprovalDefinition / DocumentDefinition / Dependency row
// tied to that release. A proper append-only versioned model (with a formal
// draft/review/publish state machine and claim/evidence-per-fact granularity)
// arrives in Phase 13.

model Industry {
  id        String               @id @default(uuid())
  code      String               @unique
  name      String
  approvals ApprovalDefinition[]

  @@map("industries")
}

model Authority {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  department   String?
  jurisdiction String?
  officialUrl  String?              @map("official_url")
  approvals    ApprovalDefinition[]
  issuedDocs   DocumentDefinition[] @relation("IssuingAuthority")

  @@map("authorities")
}

enum VerificationStatus {
  research_verified
  production_verified
}

model Source {
  id                 String               @id @default(uuid())
  url                String
  title              String
  department         String?
  publishedDate      DateTime?            @map("published_date")
  retrievedDate      DateTime             @map("retrieved_date")
  lastVerifiedDate   DateTime             @map("last_verified_date")
  verifiedBy         String               @map("verified_by")
  notes              String?              @db.Text
  sourceLastReviewed DateTime?            @map("source_last_reviewed") @db.Date
  verificationStatus VerificationStatus   @default(research_verified) @map("verification_status")
  stalenessFlag      Boolean              @default(false) @map("staleness_flag")
  approvals          ApprovalDefinition[]

  @@map("sources")
}

enum KnowledgeReleaseStatus {
  draft
  published
}

model KnowledgeRelease {
  id             String                 @id @default(uuid())
  version        String                 @unique
  status         KnowledgeReleaseStatus @default(draft)
  publishedAt    DateTime?              @map("published_at")
  publishedBy    String?                @map("published_by")
  changeSummary  String?                @map("change_summary") @db.Text
  approvals      ApprovalDefinition[]
  evaluationRuns EvaluationRun[]

  @@map("knowledge_releases")
}

model ApprovalDefinition {
  id                      String                        @id @default(uuid())
  code                    String                        @unique
  name                    String
  industryId              String                        @map("industry_id")
  industry                Industry                      @relation(fields: [industryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorityId             String                        @map("authority_id")
  authority               Authority                     @relation(fields: [authorityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  whyRequired             String                        @map("why_required") @db.Text
  applicabilityConditions Json?                         @map("applicability_conditions") @db.JsonB
  inspectionRequired      Boolean                       @map("inspection_required")
  renewalRequired         Boolean                       @map("renewal_required")
  slaDays                 Int?                          @map("sla_days")
  officialApplicationUrl  String?                       @map("official_application_url")
  ambiguityNotes          String?                       @db.Text
  // Verification state is INHERITED via sourceId -> Source
  // (verificationStatus/stalenessFlag/lastVerifiedDate). Do NOT duplicate those
  // columns here; per-row copies drift out of sync.
  sourceId                String                        @map("source_id")
  source                  Source                        @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastVerifiedDate        DateTime                      @map("last_verified_date")
  releaseId               String?                       @map("release_id")
  release                 KnowledgeRelease?             @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirements            ApprovalDocumentRequirement[]
  outgoingDeps            Dependency[]                  @relation("DepFrom")
  incomingDeps            Dependency[]                  @relation("DepTo")
  evaluationResults       EvaluationResult[]
  instances               ApprovalInstance[]

  @@map("approval_definitions")
}

enum DocumentReusability {
  reusable
  conditional
  fresh_required
  unknown
}

model DocumentDefinition {
  id                 String                        @id @default(uuid())
  code               String                        @unique
  name               String
  documentType       String                        @map("document_type")
  issuingAuthorityId String?                       @map("issuing_authority_id")
  issuingAuthority   Authority?                    @relation("IssuingAuthority", fields: [issuingAuthorityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  validityRule       String                        @map("validity_rule")
  reusability        DocumentReusability
  reuseConditions    String                        @map("reuse_conditions") @db.Text
  verificationMethod String                        @map("verification_method") @db.Text
  requirements       ApprovalDocumentRequirement[]
  documents          Document[]

  @@map("document_definitions")
}

model ApprovalDocumentRequirement {
  id                   String             @id @default(uuid())
  approvalDefinitionId String             @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition @relation(fields: [approvalDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentDefinitionId String             @map("document_definition_id")
  documentDefinition   DocumentDefinition @relation(fields: [documentDefinitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  condition            String?            @db.Text

  @@map("approval_document_requirements")
}

enum DependencyRelationship {
  depends_on
  informational
  parallel_with
  unknown
}

model Dependency {
  id              String                 @id @default(uuid())
  fromApprovalId  String                 @map("from_approval_id")
  fromApproval    ApprovalDefinition     @relation("DepFrom", fields: [fromApprovalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relationship    DependencyRelationship
  toApprovalId    String                 @map("to_approval_id")
  toApproval      ApprovalDefinition     @relation("DepTo", fields: [toApprovalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  condition       String?                @db.Text
  // REQUIRED when relationship = depends_on: specific evidence for a genuine
  // workflow-gating relationship. Enforced by CHECK constraint
  // dependencies_depends_on_requires_rationale in the migration + service-layer
  // validation (reject depends_on with empty gatingRationale).
  gatingRationale String?                @map("gating_rationale") @db.Text

  @@map("dependencies")
}

enum Role {
  applicant
  officer
  admin
}

// Minimal user record backing the auth skeleton. Extended in later phases.
model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String            @map("password_hash")
  role             Role              @default(applicant)
  memberships      ProjectMember[]
  uploadedVersions DocumentVersion[]
  corrections      FieldCorrection[]
  verificationRuns VerificationRecord[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model EvaluationRun {
  id              String             @id @default(uuid())
  profileSnapshot Json               @map("profile_snapshot") @db.JsonB
  releaseId       String?            @map("release_id")
  release         KnowledgeRelease?  @relation(fields: [releaseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  engineVersion   String             @map("engine_version")
  resultSnapshot  Json               @map("result_snapshot") @db.JsonB
  createdAt       DateTime           @default(now()) @map("created_at")
  results         EvaluationResult[]

  @@map("evaluation_runs")
}

model EvaluationResult {
  id                   String             @id @default(uuid())
  evaluationRunId      String             @map("evaluation_run_id")
  evaluationRun        EvaluationRun      @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvalDefinitionId String             @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition @relation(fields: [approvalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outcome              String
  missingFields        Json               @map("missing_fields") @db.JsonB
  instance             ApprovalInstance?

  @@map("evaluation_results")
}

// ---------------------------------------------------------------------------
// Phase 4: Approval roadmap. An ApprovalInstance is the applicant-facing
// "thing to act on" derived from one specific EvaluationResult. The instance
// NEVER stores its own outcome or attention flag: it always traces back to the
// pinned evaluation result (attentionRequired is derived at read time from
// evaluationResult.outcome === 'not_evaluable'), so it cannot drift out of
// sync with the actual evaluation. `status` is the manual progress state
// machine (blocked | available | in_progress | done) driven by the
// dependency graph, not by evaluation outcomes.
// ---------------------------------------------------------------------------

enum ApprovalInstanceStatus {
  blocked
  available
  in_progress
  done
}

model ApprovalInstance {
  id                   String                 @id @default(uuid())
  projectId            String                 @map("project_id")
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvalDefinitionId String                 @map("approval_definition_id")
  approvalDefinition   ApprovalDefinition     @relation(fields: [approvalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // The specific EvaluationResult that produced this instance. Outcome is never
  // recomputed or restated here — always read it through this relation.
  evaluationResultId   String                 @unique @map("evaluation_result_id")
  evaluationResult     EvaluationResult       @relation(fields: [evaluationResultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status               ApprovalInstanceStatus @default(blocked)
  // Set (once) when the server's dependency re-evaluation first makes this
  // instance available. Never set by the client.
  unlockedAt           DateTime?              @map("unlocked_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  documents            ApprovalInstanceDocument[]

  // One roadmap slot per approval per project; re-evaluations re-point the
  // same instance at the newer evaluation result.
  @@unique([projectId, approvalDefinitionId])
  @@index([projectId])
  @@map("approval_instances")
}

// ---------------------------------------------------------------------------
// Phase 6: ApprovalInstanceDocument join table.
// Allows a single Document to be referenced by multiple ApprovalInstances
// without duplicating the underlying file — "application packet references".
// ---------------------------------------------------------------------------

model ApprovalInstanceDocument {
  id                  String           @id @default(uuid())
  approvalInstanceId  String           @map("approval_instance_id")
  approvalInstance    ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documentId          String           @map("document_id")
  document            Document         @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt           DateTime         @default(now()) @map("created_at")

  @@unique([approvalInstanceId, documentId])
  @@map("approval_instance_documents")
}

// ---------------------------------------------------------------------------
// Phase 3: Projects + BusinessProfileVersioning. Intentionally minimal — full
// business/premises/membership modeling (Section 4 of the blueprint) is
// Phase 4+ work. Only what's needed to anchor profile versions is modeled now.
// ---------------------------------------------------------------------------

model Project {
  id                String                   @id @default(uuid())
  name              String
  industry          String
  businessId        String                   @map("business_id")
  profiles          BusinessProfileVersion[]
  approvalInstances ApprovalInstance[]
  members           ProjectMember[]
  documents         Document[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@map("projects")
}

enum ProfileStatus {
  draft
  confirmed
}

// Append-only profile versioning: a draft can be mutated freely; once
// confirmed it is immutable — further edits create a NEW version. Immutability
// is enforced in the ProfilesService (explicit status check), not via DB
// triggers (same approach as the Phase-1 KnowledgeRelease note above).
model BusinessProfileVersion {
  id            String        @id @default(uuid())
  projectId     String        @map("project_id")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionNumber Int           @map("version_number")
  values        Json          @db.JsonB
  status        ProfileStatus @default(draft)
  confirmedAt   DateTime?     @map("confirmed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("business_profile_versions")
}

// ---------------------------------------------------------------------------
// Phase 5: Document Vault.
//
// A Document is a logical object (per project) with an append-only chain of
// DocumentVersions. There is deliberately NO storage delete: superseding a
// document only marks the prior version "superseded"; its bytes stay in object
// storage. `currentVersionId` points at the latest version.
// ---------------------------------------------------------------------------

/**
 * The full lifecycle for a document version. Most states are only reachable
 * after Phase 6 (async extraction); the enum is defined in full now so there is
 * no later migration, but only `uploaded` and `superseded` are set this phase.
 */
enum DocumentVersionState {
  uploaded
  queued
  processing
  extracted
  needs_verification
  verified
  rejected
  superseded
  archived
}

/**
 * A user's membership in a project — the object-level authorization boundary.
 * A user may only read/write a project's documents when a ProjectMember row
 * links them to that project (never "just a valid JWT").
 */
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Document {
  id                   String              @id @default(uuid())
  projectId            String              @map("project_id")
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Classification may be unset or manual today; auto-classification is Phase 6.
  documentDefinitionId String?             @map("document_definition_id")
  documentDefinition   DocumentDefinition? @relation(fields: [documentDefinitionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Tracks if documentDefinitionId was manually overridden (Phase 6: manual override always wins)
  documentDefinitionManualOverride Boolean   @default(false) @map("document_definition_manual_override")
  // Free-text metadata for manual corrections/annotations
  metadata             Json?               @db.JsonB
  currentVersionId     String?             @unique @map("current_version_id")
  currentVersion       DocumentVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions             DocumentVersion[]   @relation("Owned")
  approvalInstances    ApprovalInstanceDocument[]
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("documents")
}

enum JobStatus {
  pending
  processing
  completed
  failed
  dead_letter
}

model Job {
  id                   String    @id @default(uuid())
  type                 String
  payload              Json      @db.JsonB
  payloadSchemaVersion Int       @default(1) @map("payload_schema_version")
  attemptCount         Int       @default(0) @map("attempt_count")
  idempotencyKey       String    @unique @map("idempotency_key")
  status               JobStatus @default(pending)
  errorDetails         String?   @map("error_details") @db.Text
  retryPolicy          Json      @map("retry_policy") @db.JsonB
  nextAttemptAt        DateTime  @default(now()) @map("next_attempt_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([type, status])
  @@map("jobs")
}

model DocumentVersion {
  id               String               @id @default(uuid())
  documentId       String               @map("document_id")
  document         Document             @relation("Owned", fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Inverse of Document.currentVersion — lets one side of the self-reference
  // resolve without ambiguity.
  currentFor       Document?            @relation("CurrentVersion")
  versionNumber    Int                  @map("version_number")
  // Opaque key into StorageProvider. Never exposed as a fetchable URL.
  storageKey       String               @map("storage_key")
  originalFilename String               @map("original_filename")
  mimeType         String               @map("mime_type")
  sizeBytes        Int                  @map("size_bytes")
  // sha256 (Phase 7 content dedup).
  fileHash         String               @map("file_hash")
  uploadedByUserId String               @map("uploaded_by_user_id")
  uploadedBy       User                 @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedAt       DateTime             @default(now()) @map("uploaded_at")
  state            DocumentVersionState @default(uploaded)
  extractions      ExtractionResult[]
  corrections      FieldCorrection[]
  verifications    VerificationRecord[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// Every ExtractionResult row is self-describing about what produced it.
model ExtractionResult {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fields            Json            @db.JsonB
  modelProvider     String          @map("model_provider")
  modelVersion      String          @map("model_version")
  promptVersion     String          @map("prompt_version")
  extractedAt       DateTime        @default(now()) @map("extracted_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@map("extraction_results")
}

// User corrections stored ALONGSIDE (never over) the raw extraction output.
model FieldCorrection {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fieldName         String          @map("field_name")
  correctedValue    String          @map("corrected_value") @db.Text
  source            String          @default("user_corrected")
  correctedByUserId String          @map("corrected_by_user_id")
  correctedBy       User            @relation(fields: [correctedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@map("field_corrections")
}

model VerificationRecord {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verifierUserId    String          @map("verifier_user_id")
  verifier          User            @relation(fields: [verifierUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedAt        DateTime        @default(now()) @map("verified_at")
  fieldsVerified    Json            @map("fields_verified") @db.JsonB
  notes             String?         @db.Text
  method            String          @default("manual_review")
  evidenceInspected Boolean         @map("evidence_inspected")
  verifiedBy        String          @default("applicant") @map("verified_by")

  @@index([documentVersionId])
  @@map("verification_records")
}

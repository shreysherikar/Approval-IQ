{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "ApprovalIQ API — NestJS backend service",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "import:regulatory": "tsx scripts/import-regulatory-data.ts",
    "test:unit": "tsx --test test/to-engine-condition.test.ts test/clarification-state.test.ts test/auth.google.test.ts test/inspections.unit.test.ts test/evaluations.data-depth.unit.test.ts test/extraction.provider.unit.test.ts",
    "test:unit:auth": "tsx --test test/auth.google.test.ts",
    "test:unit:inspections": "tsx --test test/inspections.unit.test.ts",
    "test:unit:data-depth": "tsx --test test/evaluations.data-depth.unit.test.ts",
    "test:unit:extraction": "tsx --test test/extraction.provider.unit.test.ts",
    "test:integration:evaluations": "tsx scripts/evaluations.integration.ts",
    "test:integration:profiles": "tsx scripts/profiles.integration.ts",
    "test:integration:roadmap": "tsx scripts/roadmap.integration.ts",
    "test:integration:roadmap-cycle": "tsx scripts/roadmap_cycle.integration.ts",
    "test:integration:documents": "tsx test/documents.integration.test.ts",
    "test:integration:intelligence": "tsx test/intelligence.integration.test.ts",
    "test:integration:consistency": "tsx test/consistency.integration.test.ts",
    "test:integration:reuse": "tsx test/reuse.integration.test.ts",
    "test:integration:clarifications": "tsx test/clarifications.integration.test.ts",
    "test:integration:grievances": "tsx test/grievances.integration.test.ts",
    "officer:assign": "tsx scripts/assign-officer.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo:reset": "tsx scripts/seed-demo.ts --reset"
  },
  "prisma": {
    "seed": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@approvaliq/approval-engine": "workspace:*",
    "@approvaliq/contracts": "workspace:*",
    "@approvaliq/document-engine": "workspace:*",
    "@approvaliq/domain-types": "workspace:*",
    "@approvaliq/storage": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.10.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2"
  }
}

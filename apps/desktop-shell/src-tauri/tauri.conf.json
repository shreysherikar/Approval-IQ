{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApprovalIQ",
  "version": "0.1.0",
  "identifier": "dev.approvaliq.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @approvaliq/web dev",
    "beforeBuildCommand": "pnpm --filter @approvaliq/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ApprovalIQ — Industrial Approvals Platform",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
